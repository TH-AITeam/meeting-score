# meeting-score 環境変数サンプル (Issue #17)
# 既定はローカル推論バックエンド (vLLM 等) を叩く構成。
# config.yaml の llm.backend / llm.endpoint / llm.model に対応する。

# ローカル推論バックエンド設定(本番運用はこれを使う)
LLM_BACKEND=local
LLM_ENDPOINT=http://localhost:8001/v1
LLM_MODEL=qwen3.6-35b-nvfp4
# vLLM が API キーを要求しない場合は空のままで良い
# LLM_API_KEY=

# OpenAI API キー(任意)
# 蒸留データ生成 (Issue #12) やベンチマーク比較で OpenAI Responses API を
# 使いたいときだけ設定する。本番の評価フローでは不要。
OPENAI_API_KEY=  # optional, only for distillation / benchmark

# 音声処理 (Issue #11) で pyannote の gated repo を使う場合
# HUGGINGFACE_HUB_TOKEN=
