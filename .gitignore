# stored meeting data (may contain personal information)
data/stored_meetings/
# フィードバック収集 DB (SQLite ローカル / Issue #78)。組織のフィードバックは
# 個人情報を含みうるためコミットしない。本番は Docker 管理の PostgreSQL を使う。
data/feedback.db
data/feedback.db-wal
data/feedback.db-shm
# eval / benchmark の生 JSON は基本ローカル保持。
# Issue #18 / #19 のエビデンスとしてコミットしたい場合のみ `git add -f reports/...` で明示追加する。
reports/

# 音声処理モデル評価データ (Issue #19)
# data/eval_audio/{meeting_*}/ 以下の音声・参照ファイルは個人録音/合成のため
# リポジトリには含めない。README と .gitkeep だけ commit する。
data/eval_audio/meeting_*/
*.wav
*.mp3
*.m4a
*.flac

# 動画アップロード効率ベンチ評価データ (Issue #68)
# data/eval_video/{meeting_*}/ 以下の動画ファイルは個人録画のため除外。
# README と .gitkeep だけ commit する。
data/eval_video/meeting_*/
*.mp4
*.mov
*.mkv
*.avi
*.webm
# Large aggregate Kokkai JSONL is split into data/kokkai/meeting_20250522_20260522/part_*.jsonl for GitHub size limits.
data/kokkai/meeting_20250522_20260522.jsonl
# LoRA training local artifacts
scripts/lora/.venv-lora/
outputs/
wandb/
unsloth_compiled_cache/
